// iOS-style Calculator
// Only digits and + - x : . are accepted (keyboard * / map to x :).
// Press Enter, =, or GO to evaluate. History shows the previous line.

import shapes { rect, text }
import render { fill, stroke }
import coords { resolution, origin, top_left }

resolution(400, 600)
origin(top_left)

state {
    let expr: string = ""
    let history: string = ""
    let error: bool = false
}

// ─── Layout ──────────────────────────────────────────────────────────────────

const PAD_X: float = 10.0
const PAD_Y: float = 200.0
const BTN_W: float = 90.0
const BTN_H: float = 70.0
const GAP: float = 5.0

// ─── Hit test ────────────────────────────────────────────────────────────────

fn hit(mx: float, my: float, col: float, row: float) -> bool {
    let x: float = PAD_X + col * (BTN_W + GAP)
    let y: float = PAD_Y + row * (BTN_H + GAP)
    return mx >= x and mx < x + BTN_W and my >= y and my < y + BTN_H
}

fn hit_wide(mx: float, my: float, row: float) -> bool {
    let x: float = PAD_X
    let y: float = PAD_Y + row * (BTN_H + GAP)
    let w: float = BTN_W * 2.0 + GAP
    return mx >= x and mx < x + w and my >= y and my < y + BTN_H
}

// ─── Simple expression evaluator ─────────────────────────────────────────────

fn eval_expr(expr: string) -> res<float> {
    let len: float = expr.len()
    if len == 0.0 { return try 0.0 }

    // Find rightmost + or - (skip position 0 for unary minus)
    for let i = len - 1.0; i >= 1.0; i-- {
        let ch: string = expr.slice(i, i + 1.0)
        if ch == "+" {
            let left: string = expr.slice(0.0, i)
            let right: string = expr.slice(i + 1.0, len)
            if left.len() > 0.0 and right.len() > 0.0 {
                let l: res<float> = eval_expr(left)
                let r: res<float> = eval_expr(right)
                if l.ok and r.ok { return try l.value + r.value }
            }
        }
        if ch == "-" {
            let left: string = expr.slice(0.0, i)
            let right: string = expr.slice(i + 1.0, len)
            if left.len() > 0.0 and right.len() > 0.0 {
                let l: res<float> = eval_expr(left)
                let r: res<float> = eval_expr(right)
                if l.ok and r.ok { return try l.value - r.value }
            }
        }
    }

    // Find rightmost * or x
    for let i = len - 1.0; i >= 1.0; i-- {
        let ch: string = expr.slice(i, i + 1.0)
        if ch == "x" {
            let left: string = expr.slice(0.0, i)
            let right: string = expr.slice(i + 1.0, len)
            if left.len() > 0.0 and right.len() > 0.0 {
                let l: res<float> = eval_expr(left)
                let r: res<float> = eval_expr(right)
                if l.ok and r.ok { return try l.value * r.value }
            }
        }
        if ch == ":" {
            let left: string = expr.slice(0.0, i)
            let right: string = expr.slice(i + 1.0, len)
            if left.len() > 0.0 and right.len() > 0.0 {
                let l: res<float> = eval_expr(left)
                let r: res<float> = eval_expr(right)
                if l.ok and r.ok { return try l.value / r.value }
            }
        }
    }

    // Base case: number
    return try (expr as float)
}

fn format_val(v: float) -> string {
    return (round(v * 100000000.0) / 100000000.0) as string
}

// Only digits, operators + - x : and one decimal per token — keyboard input is filtered.
fn allowed_calc_char(ch: string) -> bool {
    return "0123456789+-x:.".contains(ch)
}

fn append_calc_char(s: State, ch: string) -> State {
    if allowed_calc_char(ch) {
        s.expr = s.expr + ch
        s.error = false
    }
    return s
}

fn run_evaluate(s: State) -> State {
    if s.expr.len() > 0.0 {
        let r: res<float> = eval_expr(s.expr)
        if r.ok {
            s.history = s.expr + " = " + format_val(r.value)
            s.expr = format_val(r.value)
            s.error = false
        } else {
            s.history = s.expr + " = Error"
            s.expr = ""
            s.error = true
        }
    }
    return s
}

// ─── Button drawing ──────────────────────────────────────────────────────────

fn draw_btn(col: float, row: float, label: string, bg: color, fg: color) {
    let x: float = PAD_X + col * (BTN_W + GAP)
    let y: float = PAD_Y + row * (BTN_H + GAP)
    let cx: float = x + BTN_W / 2.0
    let cy: float = y + BTN_H / 2.0
    out << rect(vec2(cx, cy), vec2(BTN_W - 4, BTN_H - 4), origin: center, render: fill, color: bg)
    out << text(vec2(cx - 12, cy), label, 26.0, color: fg)
}

fn draw_btn_wide(row: float, label: string, bg: color, fg: color) {
    let x: float = PAD_X
    let y: float = PAD_Y + row * (BTN_H + GAP)
    let w: float = BTN_W * 2.0 + GAP
    let cx: float = x + w / 2.0
    let cy: float = y + BTN_H / 2.0
    out << rect(vec2(cx, cy), vec2(w - 4, BTN_H - 4), origin: center, render: fill, color: bg)
    out << text(vec2(cx - 8, cy), label, 26.0, color: fg)
}

// ─── Main ────────────────────────────────────────────────────────────────────

fn on_update(s: State, input: Input) -> State {
    let mx: float = input.mouse_x
    let my: float = input.mouse_y

    // ── Keyboard ─────────────────────────────────────────────────────────────
    let k: string = input.key_pressed
    if k != "" {
        if k == "backspace" {
            if s.expr.len() > 0.0 {
                s.expr = s.expr.slice(0.0, s.expr.len() - 1.0)
                s.error = false
            }
        } else if k == "enter" or k == "return" or k == "numenter" {
            s = run_evaluate(s)
        } else if k == "=" or k == "equal" or k == "equals" {
            s = run_evaluate(s)
        } else if k == "escape" {
            s.expr = ""
            s.history = ""
            s.error = false
        } else if k == "*" {
            s = append_calc_char(s, "x")
        } else if k == "/" {
            s = append_calc_char(s, ":")
        } else if k == "plus" {
            s = append_calc_char(s, "+")
        } else if k == "minus" {
            s = append_calc_char(s, "-")
        } else if k == "slash" {
            s = append_calc_char(s, ":")
        } else if k == "numpadadd" {
            s = append_calc_char(s, "+")
        } else if k == "numpadsubtract" {
            s = append_calc_char(s, "-")
        } else if k == "numpadmultiply" {
            s = append_calc_char(s, "x")
        } else if k == "numpaddivide" {
            s = append_calc_char(s, ":")
        } else if k.len() == 1.0 {
            s = append_calc_char(s, k)
        }
    }

    // ── Mouse clicks ─────────────────────────────────────────────────────────
    if input.mouse_pressed {
        // Row 0: AC, CE, DEL, :
        if hit(mx, my, 0, 0) {
            s.expr = ""
            s.history = ""
            s.error = false
        }
        if hit(mx, my, 1, 0) {
            s.expr = ""
            s.error = false
        }
        if hit(mx, my, 2, 0) {
            if s.expr.len() > 0.0 {
                s.expr = s.expr.slice(0.0, s.expr.len() - 1.0)
            }
            s.error = false
        }
        if hit(mx, my, 3, 0) { s.expr = s.expr + ":"  s.error = false }

        // Row 1: 7, 8, 9, x
        if hit(mx, my, 0, 1) { s.expr = s.expr + "7"  s.error = false }
        if hit(mx, my, 1, 1) { s.expr = s.expr + "8"  s.error = false }
        if hit(mx, my, 2, 1) { s.expr = s.expr + "9"  s.error = false }
        if hit(mx, my, 3, 1) { s.expr = s.expr + "x"  s.error = false }

        // Row 2: 4, 5, 6, -
        if hit(mx, my, 0, 2) { s.expr = s.expr + "4"  s.error = false }
        if hit(mx, my, 1, 2) { s.expr = s.expr + "5"  s.error = false }
        if hit(mx, my, 2, 2) { s.expr = s.expr + "6"  s.error = false }
        if hit(mx, my, 3, 2) { s.expr = s.expr + "-"  s.error = false }

        // Row 3: 1, 2, 3, +
        if hit(mx, my, 0, 3) { s.expr = s.expr + "1"  s.error = false }
        if hit(mx, my, 1, 3) { s.expr = s.expr + "2"  s.error = false }
        if hit(mx, my, 2, 3) { s.expr = s.expr + "3"  s.error = false }
        if hit(mx, my, 3, 3) { s.expr = s.expr + "+"  s.error = false }

        // Row 4: 0 (wide), ., GO
        if hit_wide(mx, my, 4) { s.expr = s.expr + "0"  s.error = false }
        if hit(mx, my, 2, 4) { s.expr = s.expr + "."  s.error = false }
        if hit(mx, my, 3, 4) { s = run_evaluate(s) }
    }

    // ═══ RENDER ══════════════════════════════════════════════════════════════

    // Background
    out << rect(vec2(200, 300), vec2(400, 600), origin: center, render: fill, color: #000000)

    // Display area background
    out << rect(vec2(200, 95), vec2(380, 170), origin: center, render: fill, color: #1c1c1e)

    // History (small, top)
    if s.history.len() > 0.0 {
        let hist_display: string = s.history
        if hist_display.len() > 24.0 {
            hist_display = hist_display.slice(hist_display.len() - 24.0, hist_display.len())
        }
        out << text(vec2(20, 40), hist_display, 16.0, color: #6e6e73)
    }

    // Current expression (large, main display)
    let display: string = s.expr
    if display.len() == 0.0 {
        display = "0"
    }
    if display.len() > 14.0 {
        display = display.slice(display.len() - 14.0, display.len())
    }
    let expr_col: color = #ffffff
    if s.error { expr_col = #ff453a }
    out << text(vec2(20, 120), display, 44.0, color: expr_col)

    // ── Buttons ──────────────────────────────────────────────────────────────
    let dark: color = #333333
    let orange: color = #ff9f0a
    let light: color = #a5a5a5

    // Row 0: AC, CE, DEL, divide
    draw_btn(0, 0, "AC", light, #000000)
    draw_btn(1, 0, "CE", light, #000000)
    draw_btn(2, 0, "DEL", light, #000000)
    draw_btn(3, 0, ":", orange, #ffffff)

    // Row 1: 7 8 9 multiply
    draw_btn(0, 1, "7", dark, #ffffff)
    draw_btn(1, 1, "8", dark, #ffffff)
    draw_btn(2, 1, "9", dark, #ffffff)
    draw_btn(3, 1, "x", orange, #ffffff)

    // Row 2: 4 5 6 minus
    draw_btn(0, 2, "4", dark, #ffffff)
    draw_btn(1, 2, "5", dark, #ffffff)
    draw_btn(2, 2, "6", dark, #ffffff)
    draw_btn(3, 2, "-", orange, #ffffff)

    // Row 3: 1 2 3 plus
    draw_btn(0, 3, "1", dark, #ffffff)
    draw_btn(1, 3, "2", dark, #ffffff)
    draw_btn(2, 3, "3", dark, #ffffff)
    draw_btn(3, 3, "+", orange, #ffffff)

    // Row 4: 0 (wide), dot, GO
    draw_btn_wide(4, "0", dark, #ffffff)
    draw_btn(2, 4, ".", dark, #ffffff)
    draw_btn(3, 4, "GO", orange, #ffffff)

    return s
}
