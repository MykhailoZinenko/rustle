// Galaxy Simulation — A swirling galaxy with thousands of stars, nebula clouds,
// gravitational lensing effects, and orbital mechanics.
// Stress-tests: deep nested loops, heavy trig math, hundreds of shapes per frame,
// list manipulation, function call depth, state mutation, and string interpolation.

import shapes { circle, rect, line, polygon, center }
import render { fill, sdf, outline, stroke }
import coords { resolution, origin }

resolution(1000, 1000)
origin(center)

state {
    let t: float = 0.0
    let frame: float = 0.0
    let arm_twist: float = 0.0
}

// ─── Pseudo-random hash (no built-in random — use deterministic noise) ──────

fn hash(n: float) -> float {
    let x: float = sin(n) * 43758.5453
    return x - floor(x)
}

fn hash2(x: float, y: float) -> float {
    return hash(x * 127.1 + y * 311.7)
}

fn noise(x: float, y: float) -> float {
    let ix: float = floor(x)
    let iy: float = floor(y)
    let fx: float = x - ix
    let fy: float = y - iy
    let ux: float = fx * fx * (3.0 - 2.0 * fx)
    let uy: float = fy * fy * (3.0 - 2.0 * fy)
    let a: float = hash2(ix, iy)
    let b: float = hash2(ix + 1.0, iy)
    let c: float = hash2(ix, iy + 1.0)
    let d: float = hash2(ix + 1.0, iy + 1.0)
    let ab: float = lerp(a, b, ux)
    let cd: float = lerp(c, d, ux)
    return lerp(ab, cd, uy)
}

fn fbm(x: float, y: float, octaves: float) -> float {
    let val: float = 0.0
    let amp: float = 0.5
    let freq: float = 1.0
    for let i = 0.0; i < octaves; i++ {
        val = val + noise(x * freq, y * freq) * amp
        amp = amp * 0.5
        freq = freq * 2.0
    }
    return val
}

// ─── Spiral arm density function ────────────────────────────────────────────

fn spiral_density(angle: float, radius: float, arm_count: float, twist: float, tightness: float) -> float {
    let best: float = 0.0
    for let arm = 0.0; arm < arm_count; arm++ {
        let arm_angle: float = arm / arm_count * TAU
        let expected_angle: float = arm_angle + radius * tightness + twist
        let diff: float = angle - expected_angle
        // Wrap to [-PI, PI]
        diff = diff - round(diff / TAU) * TAU
        let d: float = abs(diff)
        let falloff: float = 1.0 / (1.0 + d * d * 8.0)
        let radial_fade: float = 1.0 / (1.0 + radius * 0.003)
        let density: float = falloff * radial_fade
        if density > best {
            best = density
        }
    }
    return best
}

// ─── Elliptical orbit helper ────────────────────────────────────────────────

fn orbit_pos(cx: float, cy: float, a: float, b: float, angle: float, tilt: float) -> vec2 {
    let cos_t: float = cos(tilt)
    let sin_t: float = sin(tilt)
    let ox: float = a * cos(angle)
    let oy: float = b * sin(angle)
    let rx: float = ox * cos_t - oy * sin_t
    let ry: float = ox * sin_t + oy * cos_t
    return vec2(cx + rx, cy + ry)
}

// ─── Star field layer (background fixed stars) ──────────────────────────────

fn draw_starfield(t: float) {
    let star_count: float = 120
    for let i = 0.0; i < star_count; i++ {
        let seed: float = i * 7.31
        let sx: float = (hash(seed) - 0.5) * 980.0
        let sy: float = (hash(seed + 1.0) - 0.5) * 980.0
        let brightness: float = hash(seed + 2.0)
        let twinkle: float = sin(t * (1.0 + hash(seed + 3.0) * 3.0) + seed) * 0.5 + 0.5
        let r: float = (0.5 + brightness * 1.5) * (0.6 + twinkle * 0.4)
        if r > 0.3 {
            let star = circle(vec2(sx, sy), r, render: fill)
            out << star
        }
    }
}

// ─── Nebula clouds (rendered as overlapping translucent circles) ────────────

fn draw_nebula(t: float) {
    let cloud_count: float = 40
    for let i = 0.0; i < cloud_count; i++ {
        let seed: float = i * 13.37
        let base_angle: float = hash(seed) * TAU
        let base_r: float = 80.0 + hash(seed + 1.0) * 250.0
        let drift: float = t * 0.02 * (hash(seed + 2.0) - 0.5)
        let cx: float = cos(base_angle + drift) * base_r
        let cy: float = sin(base_angle + drift) * base_r
        let cloud_r: float = 30.0 + hash(seed + 3.0) * 60.0
        let pulse: float = sin(t * 0.3 + seed) * 0.2 + 1.0
        let cloud = circle(vec2(cx, cy), cloud_r * pulse, render: sdf)
        out << cloud
    }
}

// ─── Galaxy spiral arms (the main attraction) ───────────────────────────────

fn draw_spiral_arms(t: float, arm_twist: float) {
    let arm_count: float = 4
    let stars_per_arm: float = 80
    let max_radius: float = 380.0

    for let arm = 0.0; arm < arm_count; arm++ {
        let arm_base: float = arm / arm_count * TAU

        for let j = 0.0; j < stars_per_arm; j++ {
            let progress: float = (j + 1.0) / stars_per_arm
            let r: float = progress * max_radius
            let twist_amount: float = progress * 2.5 + arm_twist
            let base_angle: float = arm_base + twist_amount

            // Add noise displacement for organic feel
            let seed: float = arm * 1000.0 + j
            let nx: float = (hash(seed) - 0.5) * 30.0 * progress
            let ny: float = (hash(seed + 100.0) - 0.5) * 30.0 * progress

            let x: float = cos(base_angle) * r + nx
            let y: float = sin(base_angle) * r + ny

            // Star size varies with density and position
            let density: float = spiral_density(base_angle, r, arm_count, arm_twist, 2.5 / max_radius)
            let base_size: float = 1.0 + density * 4.0
            let flicker: float = sin(t * 2.0 + seed * 0.1) * 0.3 + 0.7
            let size: float = base_size * flicker * (1.0 - progress * 0.3)

            if size > 0.5 {
                // Brighter stars near arm center get SDF glow
                let mode: render_mode = fill
                if density > 0.4 {
                    mode = sdf
                }
                let star = circle(vec2(x, y), size, render: mode)
                out << star
            }
        }
    }
}

// ─── Core glow (galactic nucleus) ───────────────────────────────────────────

fn draw_core(t: float) {
    // Layered core with pulsing rings
    let core_layers: float = 8
    for let i = 0.0; i < core_layers; i++ {
        let layer_r: float = 5.0 + i * 8.0
        let pulse: float = sin(t * 1.5 + i * 0.8) * 3.0
        let c = circle(vec2(0, 0), layer_r + pulse, render: sdf)
        out << c
    }

    // Bright center
    let center_pulse: float = sin(t * 2.0) * 2.0 + 12.0
    let core = circle(vec2(0, 0), center_pulse, render: fill)
    out << core

    // Core accretion disk — tight elliptical ring of fast particles
    let disk_count: float = 48
    for let i = 0.0; i < disk_count; i++ {
        let angle: float = i / disk_count * TAU + t * 3.0
        let wobble: float = sin(angle * 6.0 + t * 5.0) * 3.0
        let pos: vec2 = orbit_pos(0, 0, 45.0 + wobble, 20.0, angle, t * 0.5)
        let dot_size: float = 1.0 + sin(t * 4.0 + i) * 0.5
        let dot = circle(pos, dot_size, render: fill)
        out << dot
    }
}

// ─── Orbiting star clusters ─────────────────────────────────────────────────

fn draw_cluster(cx: float, cy: float, count: float, spread: float, t: float, seed_base: float) {
    for let i = 0.0; i < count; i++ {
        let seed: float = seed_base + i * 3.7
        let angle: float = hash(seed) * TAU + t * (0.3 + hash(seed + 1.0) * 0.5)
        let dist: float = hash(seed + 2.0) * spread
        let x: float = cx + cos(angle) * dist
        let y: float = cy + sin(angle) * dist
        let size: float = 0.8 + hash(seed + 3.0) * 2.0
        let star = circle(vec2(x, y), size, render: fill)
        out << star
    }
}

fn draw_orbiting_clusters(t: float) {
    let cluster_count: float = 5
    for let i = 0.0; i < cluster_count; i++ {
        let orbit_angle: float = i / cluster_count * TAU + t * 0.15
        let orbit_r: float = 200.0 + i * 40.0
        let eccentricity: float = 0.3 + hash(i * 11.0) * 0.4
        let pos: vec2 = orbit_pos(0, 0, orbit_r, orbit_r * (1.0 - eccentricity), orbit_angle, i * 0.5)
        let cluster_size: float = 15.0 + hash(i * 17.0) * 25.0
        let n_stars: float = 12.0 + floor(hash(i * 23.0) * 18.0)
        draw_cluster(pos.x, pos.y, n_stars, cluster_size, t, i * 500.0)
    }
}

// ─── Gravitational lensing arcs ─────────────────────────────────────────────

fn draw_lensing_arcs(t: float) {
    let arc_sets: float = 3
    for let s = 0.0; s < arc_sets; s++ {
        let base_r: float = 100.0 + s * 70.0
        let n_points: float = 30
        let arc_offset: float = t * 0.2 + s * TAU / 3.0
        let wobble_freq: float = 3.0 + s

        for let i = 0.0; i < n_points; i++ {
            let frac: float = i / n_points
            let angle: float = frac * PI * 0.8 + arc_offset
            let r_distort: float = base_r + sin(angle * wobble_freq + t) * 15.0
            let x: float = cos(angle) * r_distort
            let y: float = sin(angle) * r_distort
            let size: float = 1.0 + sin(frac * PI) * 2.0
            let dot = circle(vec2(x, y), size, render: fill)
            out << dot
        }

        // Mirror arc
        for let i = 0.0; i < n_points; i++ {
            let frac: float = i / n_points
            let angle: float = frac * PI * 0.8 + arc_offset + PI
            let r_distort: float = base_r + sin(angle * wobble_freq + t) * 15.0
            let x: float = cos(angle) * r_distort
            let y: float = sin(angle) * r_distort
            let size: float = 1.0 + sin(frac * PI) * 2.0
            let dot = circle(vec2(x, y), size, render: fill)
            out << dot
        }
    }
}

// ─── Dust lanes (dark streaks across arms) ──────────────────────────────────

fn draw_dust_lanes(t: float) {
    let lane_count: float = 6
    for let lane = 0.0; lane < lane_count; lane++ {
        let angle: float = lane / lane_count * TAU + t * 0.05
        let n_segments: float = 20
        for let i = 0.0; i < n_segments; i++ {
            let progress: float = i / n_segments
            let r: float = 60.0 + progress * 280.0
            let curve: float = angle + progress * 1.8
            let perturb: float = fbm(lane * 3.0, progress * 5.0 + t * 0.1, 3) * 20.0
            let x: float = cos(curve) * r + cos(curve + PI / 2.0) * perturb
            let y: float = sin(curve) * r + sin(curve + PI / 2.0) * perturb
            let width: float = 3.0 + sin(progress * PI) * 8.0
            let dust = circle(vec2(x, y), width, render: outline)
            out << dust
        }
    }
}

// ─── Satellite galaxies ─────────────────────────────────────────────────────

fn draw_satellite(cx: float, cy: float, size: float, n_arms: float, t: float) {
    // Mini galaxy core
    let core = circle(vec2(cx, cy), size * 0.15, render: sdf)
    out << core

    // Mini spiral arms
    let stars_per_arm: float = 20
    for let arm = 0.0; arm < n_arms; arm++ {
        let arm_base: float = arm / n_arms * TAU
        for let j = 0.0; j < stars_per_arm; j++ {
            let progress: float = (j + 1.0) / stars_per_arm
            let r: float = progress * size
            let twist: float = progress * 2.0 + t * 0.8
            let angle: float = arm_base + twist
            let seed: float = arm * 100.0 + j * 7.0
            let jitter_x: float = (hash(seed) - 0.5) * 8.0 * progress
            let jitter_y: float = (hash(seed + 50.0) - 0.5) * 8.0 * progress
            let x: float = cx + cos(angle) * r + jitter_x
            let y: float = cy + sin(angle) * r + jitter_y
            let dot_size: float = 0.5 + (1.0 - progress) * 1.5
            let dot = circle(vec2(x, y), dot_size, render: fill)
            out << dot
        }
    }
}

fn draw_satellites(t: float) {
    // Two satellite galaxies orbiting the main one
    let sat1_angle: float = t * 0.08
    let sat1_x: float = cos(sat1_angle) * 420.0
    let sat1_y: float = sin(sat1_angle) * 350.0
    draw_satellite(sat1_x, sat1_y, 60.0, 2, t)

    let sat2_angle: float = t * 0.06 + PI * 0.7
    let sat2_x: float = cos(sat2_angle) * 380.0
    let sat2_y: float = sin(sat2_angle) * 440.0
    draw_satellite(sat2_x, sat2_y, 45.0, 3, t)
}

// ─── Shooting stars (fast-moving streaks) ───────────────────────────────────

fn draw_shooting_stars(t: float) {
    let n_streaks: float = 4
    for let i = 0.0; i < n_streaks; i++ {
        let cycle: float = 8.0 + i * 3.0
        let phase: float = (t + i * 2.5) - floor((t + i * 2.5) / cycle) * cycle
        if phase < 1.5 {
            let progress: float = phase / 1.5
            let seed: float = floor((t + i * 2.5) / cycle) * 100.0 + i
            let start_angle: float = hash(seed) * TAU
            let start_r: float = 350.0 + hash(seed + 1.0) * 100.0
            let sx: float = cos(start_angle) * start_r
            let sy: float = sin(start_angle) * start_r
            let dx: float = -cos(start_angle) * 200.0
            let dy: float = -sin(start_angle) * 200.0

            // Trail of dots
            let trail_len: float = 8
            for let j = 0.0; j < trail_len; j++ {
                let tp: float = progress - j * 0.03
                if tp > 0.0 and tp < 1.0 {
                    let x: float = sx + dx * tp
                    let y: float = sy + dy * tp
                    let fade: float = 1.0 - j / trail_len
                    let size: float = 1.0 + fade * 2.0
                    let dot = circle(vec2(x, y), size, render: fill)
                    out << dot
                }
            }
        }
    }
}

// ─── HUD overlay (frame counter and time display) ───────────────────────────

fn draw_info_rings(t: float, frame: float) {
    // Slowly rotating measurement rings at edges
    let n_ticks: float = 36
    let ring_r: float = 470.0
    for let i = 0.0; i < n_ticks; i++ {
        let angle: float = i / n_ticks * TAU + t * 0.03
        let tick_len: float = 5.0
        if i % 3.0 == 0.0 {
            tick_len = 10.0
        }
        if i % 9.0 == 0.0 {
            tick_len = 18.0
        }
        let inner_r: float = ring_r - tick_len
        let x1: float = cos(angle) * inner_r
        let y1: float = sin(angle) * inner_r
        let x2: float = cos(angle) * ring_r
        let y2: float = sin(angle) * ring_r
        let tick = line(vec2(x1, y1), vec2(x2, y2))
        out << tick
    }

    // Second ring counter-rotating
    let ring2_r: float = 455.0
    let n_ticks2: float = 60
    for let i = 0.0; i < n_ticks2; i++ {
        let angle: float = i / n_ticks2 * TAU - t * 0.05
        let x1: float = cos(angle) * (ring2_r - 3.0)
        let y1: float = sin(angle) * (ring2_r - 3.0)
        let x2: float = cos(angle) * ring2_r
        let y2: float = sin(angle) * ring2_r
        let tick = line(vec2(x1, y1), vec2(x2, y2))
        out << tick
    }
}

// ─── Main animation loop ────────────────────────────────────────────────────

fn on_update(s: State, input: Input) -> State {
    s.t = s.t + input.dt
    s.frame = s.frame + 1.0
    s.arm_twist = s.t * 0.12

    // Log performance every 100 frames
    if s.frame % 100.0 == 0.0 {
        console << `frame ${s.frame as string}: t=${(round(s.t * 100.0) / 100.0) as string}s`
    }

    // ── Render layers (back to front) ──

    // 1. Background
    let bg = rect(vec2(0, 0), vec2(1020, 1020), render: fill)
    out << bg

    // 2. Distant star field
    draw_starfield(s.t)

    // 3. Nebula clouds
    draw_nebula(s.t)

    // 4. Dust lanes
    draw_dust_lanes(s.t)

    // 5. Gravitational lensing
    draw_lensing_arcs(s.t)

    // 6. Spiral arms (heaviest computation)
    draw_spiral_arms(s.t, s.arm_twist)

    // 7. Orbiting star clusters
    draw_orbiting_clusters(s.t)

    // 8. Galactic core
    draw_core(s.t)

    // 9. Satellite galaxies
    draw_satellites(s.t)

    // 10. Shooting stars
    draw_shooting_stars(s.t)

    // 11. HUD rings
    draw_info_rings(s.t, s.frame)

    return s
}
